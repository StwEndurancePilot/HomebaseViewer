<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RdwSource Condition="'$(RdwSource)' == ''">$(MSBuildThisFileDirectory)..\..\..\RDW-source</RdwSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RdwSource)/src/STW.Core/BlueprintCaptureFile.cs" Link="BlueprintCaptureFile.cs" />
    <Compile Include="$(RdwSource)/src/STW.Core/BlueprintCaptureNumbers.cs" Link="BlueprintCaptureNumbers.cs" />
    <Compile Include="$(RdwSource)/src/STW.Installer/Storage/HomebaseSaveFile.cs" Link="HomebaseSaveFile.cs" />
  </ItemGroup>
</Project>
